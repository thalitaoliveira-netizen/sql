/* CONSULTAS COM JOIN*/

/* INNER JOIN */

SELECT
    A.ID_ALUNO,
    A.NOME,
    A.EMAIL,
    T.NOME_TURMA,
    T.TURNO
FROM ALUNO A
INNER JOIN TURMA T
ON A.ID_TURMA = T.ID_TURMA;

/* LEFT JOIN */

SELECT
    A.NOME,
    T.NOME_TURMA
FROM ALUNO A
LEFT JOIN TURMA T
ON A.ID_TURMA = T.ID_TURMA;

/* RIGHT JOIN */

SELECT
    A.NOME,
    T.NOME_TURMA
FROM ALUNO A
RIGHT JOIN TURMA T
ON A.ID_TURMA = T.ID_TURMA;

