CREATE DATABASE ESCOLA;

USE ESCOLA;

/* CRIAÇÃO DAS TABELAS */

/* TABELA TURMA */
CREATE TABLE TURMA (
    ID_TURMA INT AUTO_INCREMENT PRIMARY KEY,
    NOME_TURMA VARCHAR(50) NOT NULL,
    TURNO VARCHAR(20) NOT NULL
);

/* TABELA ALUNO */
CREATE TABLE ALUNO (
    ID_ALUNO INT AUTO_INCREMENT PRIMARY KEY,
    NOME VARCHAR(100) NOT NULL,
    EMAIL VARCHAR(100) NOT NULL,
    ENDERECO VARCHAR(150),
    ID_TURMA INT,

    CONSTRAINT FK_ALUNO_TURMA
    FOREIGN KEY (ID_TURMA)
    REFERENCES TURMA(ID_TURMA)
);

/* TABELA DE LOG PARA O TRIGGER */
CREATE TABLE LOG_ALUNO (
    ID_LOG INT AUTO_INCREMENT PRIMARY KEY,
    ID_ALUNO INT,
    ACAO VARCHAR(100),
    DATA_ACAO DATETIME
);

/*TRIGGER - REGISTRA AUTOMATICAMENTE QUANDO UM ALUNO É INSERIDO*/

DELIMITER $$

CREATE TRIGGER TRG_INSERIR_ALUNO
AFTER INSERT
ON ALUNO
FOR EACH ROW
BEGIN

    INSERT INTO LOG_ALUNO (
        ID_ALUNO,
        ACAO,
        DATA_ACAO
    )
    VALUES (
        NEW.ID_ALUNO,
        'ALUNO INSERIDO',
        NOW()
    );

END $$

DELIMITER ;

